{
  "info": {
    "_postman_id": "d9da2ce2-8bb2-4d07-9ff7-58c2d55b48e8",
    "name": "StreamSignal SIP v1",
    "description": "Postman collection for the StreamSignal SIP v1 localhost endpoints. The default baseUrl is http://127.0.0.1:47020; update it if StreamSignal selects another port in the 47020-47029 range.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:47020",
      "type": "string"
    },
    {
      "key": "profileName",
      "value": "Music Stream",
      "type": "string"
    },
    {
      "key": "confirmationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Discovery",
      "item": [
        {
          "name": "App Identity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/app",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "app"
              ]
            },
            "description": "Returns StreamSignal's SIP app identity, product version, runtime mode, SIP protocol version, and capability names. Expect protocolVersion 1."
          },
          "response": []
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Returns StreamSignal's SIP health state: ready, degraded, or error."
          },
          "response": []
        },
        {
          "name": "Capabilities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/capabilities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "capabilities"
              ]
            },
            "description": "Returns SIP capability names and legacy capability flags. Command/action endpoints remain out of scope; lifecycle publishing is exposed only through POST /api/v1/announce and POST /api/v1/end-stream."
          },
          "response": []
        },
        {
          "name": "Announcement Fields",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/announcement-fields",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "announcement-fields"
              ]
            },
            "description": "Returns StreamSignal-owned announcement field definitions and current values."
          },
          "response": []
        },
        {
          "name": "Update Announcement Fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": [\n    {\n      \"id\": \"game\",\n      \"value\": \"Clair Obscur\"\n    },\n    {\n      \"id\": \"event\",\n      \"value\": \"Blind Playthrough\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/announcement-fields",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "announcement-fields"
              ]
            },
            "description": "Updates current values for existing announcement fields. StreamSignal owns field definitions; this request cannot create or delete fields."
          },
          "response": []
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "status"
              ]
            },
            "description": "Returns SIP-visible status, including healthy, activeProfile/activeProfileId after activation, group-aware destination counts, enabled destination platforms, destination-template summary text, image summary text, and active profile display defaults. Drawer metadata intentionally omits raw destination config, credentials, webhook URLs, tokens, secret references, and raw image URLs/data."
          },
          "response": [
            {
              "name": "Activated profile with drawer metadata",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/status",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "status"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "Cache-Control",
                  "value": "no-store"
                },
                {
                  "key": "X-Content-Type-Options",
                  "value": "nosniff"
                }
              ],
              "body": "{\n  \"state\": \"idle\",\n  \"message\": \"Ready for announcement setup.\",\n  \"activeProfile\": \"Music Stream\",\n  \"activeProfileId\": \"music\",\n  \"healthy\": true,\n  \"destinationCount\": 3,\n  \"enabledDestinationCount\": 2,\n  \"destinationGroup\": \"Main Announcements\",\n  \"destinationGroupId\": \"main-announcements\",\n  \"destinationPlatforms\": [\n    \"bluesky\",\n    \"discord\"\n  ],\n  \"image\": \"Announcement image + Bluesky card thumbnail\",\n  \"template\": \"2 destination templates\",\n  \"templateCount\": 2,\n  \"streamTitle\": \"Late Night Music\",\n  \"streamUrl\": \"https://example.com/live\",\n  \"category\": \"Music\",\n  \"hashtags\": \"#music #live\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "LivePanel Workflow",
      "item": [
        {
          "name": "List Profiles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "profiles"
              ]
            },
            "description": "Lists existing StreamSignal announcement profile names. Set the collection profileName variable to one of these names before activating."
          },
          "response": []
        },
        {
          "name": "Current Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile/current",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "profile",
                "current"
              ]
            },
            "description": "Returns the currently active SIP profile, or empty id/name when no profile is active."
          },
          "response": []
        },
        {
          "name": "Activate Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": \"{{profileName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "profile"
              ]
            },
            "description": "Activates an existing announcement profile by name. This marks usage and updates backend SIP active-profile state, but does not publish by itself."
          },
          "response": []
        },
        {
          "name": "Announce Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/announce/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "announce",
                "status"
              ]
            },
            "description": "Returns the most recent SIP announcement operation. Before the first attempt, lastRun is empty and success is false."
          },
          "response": []
        },
        {
          "name": "Send Announcement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/announce",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "announce"
              ]
            },
            "description": "Triggers the existing Go Live announcement workflow using the active SIP profile defaults. This can publish to configured destinations."
          },
          "response": []
        },
        {
          "name": "Announce Confirm",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmationId\": \"{{confirmationId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/announce/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "announce",
                "confirm"
              ]
            },
            "description": "Confirms a pending duplicate guard from Send Announcement. Copy confirmationId from the guarded announce response or announce status. This calls the existing Force Go Live path for the guarded announcement snapshot."
          },
          "response": []
        },
        {
          "name": "End Stream Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/end-stream/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "end-stream",
                "status"
              ]
            },
            "description": "Returns the most recent SIP end-stream operation. Before the first attempt, lastRun is empty and success is false."
          },
          "response": []
        },
        {
          "name": "End Stream",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/end-stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "end-stream"
              ]
            },
            "description": "Triggers the existing End Stream workflow using the active SIP profile defaults. This can publish end-stream messages and clear Live Now state for configured destinations."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Negative and Security Checks",
      "item": [
        {
          "name": "Announce Rejects Unknown Fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"go_live\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/announce",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "announce"
              ]
            },
            "description": "Security check: POST /api/v1/announce accepts only an empty JSON object. Expect 400 InvalidRequest."
          },
          "response": []
        },
        {
          "name": "End Stream Rejects Unknown Fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"end_stream\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/end-stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "end-stream"
              ]
            },
            "description": "Security check: POST /api/v1/end-stream accepts only an empty JSON object. Expect 400 InvalidRequest."
          },
          "response": []
        },
        {
          "name": "Announce Confirm Rejects Unknown Fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmationId\": \"{{confirmationId}}\",\n  \"command\": \"force_go_live\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/announce/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "announce",
                "confirm"
              ]
            },
            "description": "Security check: POST /api/v1/announce/confirm accepts only confirmationId. Expect 400 InvalidRequest."
          },
          "response": []
        },
        {
          "name": "Profile Rejects Text Plain",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"profile\":\"{{profileName}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "profile"
              ]
            },
            "description": "Security check: profile activation requires application/json. Expect 415 InvalidRequest."
          },
          "response": []
        },
        {
          "name": "Generic Command Endpoint Missing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"go_live\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/command",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "command"
              ]
            },
            "description": "Security/design check: generic command endpoints are intentionally absent. Expect 404."
          },
          "response": []
        }
      ]
    }
  ]
}
