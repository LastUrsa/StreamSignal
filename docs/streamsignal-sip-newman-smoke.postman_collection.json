                  "  pm.expect(body.error).to.eql(\"InvalidRequest\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile Rejects Text Plain",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
